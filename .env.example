# ==========================================
# AgentForge · 智炼工坊 环境变量模板 (.env.example)
# 使用说明：请复制此文件为 .env 并填入您真实的 API Key 与数据库凭据
# ==========================================

# 运行环境与服务密钥
APP_ENV=development
# JWT_SECRET 示例值仅用于说明格式，部署前必须替换为随机值。
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# 大模型接口配置 (OpenAI / DeepSeek / 本地 vLLM)
OPENAI_API_KEY=your_openai_or_deepseek_api_key_here
OPENAI_API_BASE=https://api.deepseek.com

# 业务数据库与队列配置
# 注意：以下 POSTGRES_* 三项为 docker-compose 启动的必备变量，
# 未设置时 compose 会直接报错退出（避免使用内置默认弱口令）。
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=ailearning
DATABASE_URL=postgresql://aiuser:password@localhost:5432/ailearning
ASYNC_DATABASE_URL=postgresql+asyncpg://aiuser:password@localhost:5432/ailearning
REDIS_URL=redis://localhost:6379/0
MYSQL_URI=mysql+pymysql://root:password@localhost:3306/freshchain?charset=utf8mb4

# LangSmith 可观测性与追踪 (可选)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agentforge-enterprise
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# DeepSeek 模型动态路由标识
MODEL_FLASH=deepseek-v4-flash
MODEL_PRO=deepseek-v4-pro
MODEL_NAME=deepseek-v4-pro

# 多模态与 OCR 视觉识别配置
DEEPSEEK_OCR_MODEL_NAME=DeepSeek-OCR-2
VISION_MODEL_NAME=DeepSeek-OCR-2
VISION_API_BASE=https://api.deepseek.com
